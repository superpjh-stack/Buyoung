# Database
DATABASE_URL=postgresql+asyncpg://buyoung:password@localhost:5432/buyoung_mes
DATABASE_URL_SYNC=postgresql://buyoung:password@localhost:5432/buyoung_mes

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# S3 (CAD 도면, 비드 이미지 저장)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-northeast-2
S3_BUCKET=buyoung-mes-files

# Redis (Celery 브로커, 캐시)
REDIS_URL=redis://localhost:6379/0

# AI
OPENAI_API_KEY=your-openai-key
CAD_ML_MODEL_PATH=./models/cad_quote_xgboost.json

# App
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000
